{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/site-aventis-ma", "destination": "/site-aventis-ma/index.html" },
    { "source": "/site-aventis-ma/analise", "destination": "/site-aventis-ma/analise.html" },
    { "source": "/site-aventis-ma/analise.pdf", "destination": "/site-aventis-ma/analise.html" },
    { "source": "/aventis-ma", "destination": "/site-aventis-ma/index.html" },
    { "source": "/:slug(proposta-escom-[a-zA-Z0-9-]+)", "destination": "/baseproposta" },
    { "source": "/template-silva-autocenter/silva-autocenter.pdf", "destination": "/template-silva-autocenter/dossie" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/admin/(.*)", "destination": "/admin" },
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/portfolioedu", "destination": "/portfolioedu/index.html" },
    { "source": "/portfolio-projetos", "destination": "/portfolio-projetos/index.html" },
    { "source": "/piassa(.*)", "destination": "/piassa/index.html" },

    { "source": "/template-ci-odontologia", "destination": "/template-ci-odontologia.html" },
    { "source": "/site-onward-consultoria", "destination": "/site-onward-consultoria.html" },
    { "source": "/site-onward-consultoria/analise", "destination": "/site-onward-consultoria/analise.html" },
    { "source": "/site-onward-consultoria/analise.pdf", "destination": "/site-onward-consultoria/analise.html" },
    { "source": "/onward-modelo-site", "destination": "/site-onward-consultoria.html" },
    { "source": "/onward-modelo-site/analise", "destination": "/site-onward-consultoria/analise.html" },
    { "source": "/onward-modelo-site/analise.pdf", "destination": "/site-onward-consultoria/analise.html" }
  ],
  "crons": [
    {
      "path": "/api/trigger-minera",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/piassa-cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/trigger-cron",
      "schedule": "0 8 * * *"
    }
  ]
}
