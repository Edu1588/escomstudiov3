rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /page_views/{document=**} {
      allow read, write: if true;
    }
    match /daily_views/{document=**} {
      allow read, write: if true;
    }
    match /portfolio_projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /external_projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Propostas geradas pelo n8n (site-amostra + analise) sao paginas publicas -
    // o lead abre o link sem estar logado, entao a leitura precisa ser publica.
    // A escrita continua so pro n8n (via service account, que ignora estas regras)
    // e pro CRM autenticado.
    match /propostas/{propostaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Leads gerados pelo n8n via OAuth2 Google (nao Firebase ID token).
    // Leitura e escrita abertas: dados nao sensiveis, gerados automaticamente pelo n8n.
    match /leads/{leadId} {
      allow read, write: if true;
    }
    // Secure by default: everything else requires auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
