# CONFIGURAÇÃO DE E-MAIL (RESEND)
# Crie uma conta em resend.com e gere sua API Key.
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=es.comunicacao@outlook.com

# GROQ API PARA IA (Llama 3, Mixtral) E SERPER PARA BUSCA DE LEADS/VAGAS
GROQ_API_KEY=gsk_your_api_key_here
SERPER_API_KEY=your_serper_dev_api_key_here

# ENTERPRISE SECURITY CONFIGURATION
NODE_ENV=development

# INTEGRATION WITH GOOGLE SHEETS
# URL do webhook (ex: Google Apps Script Web App URL ou Make/Zapier webhook)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec

# GOOGLE STITCH API (geração de UI por IA)
# Gere sua chave em stitch.withgoogle.com/settings
STITCH_API_KEY=sua_stitch_api_key_aqui
