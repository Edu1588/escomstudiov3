# CONFIGURAÇÃO DE E-MAIL (RESEND)
# Crie uma conta em resend.com e gere sua API Key.
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=es.comunicacao@outlook.com

# GROQ API PARA IA (Llama 3, Mixtral) E SERPER PARA BUSCA DE LEADS/VAGAS
GROQ_API_KEY=gsk_your_api_key_here
SERPER_API_KEY=your_serper_dev_api_key_here

# FIREBASE CONFIGURAÇÃO (Opcional, para salvar leads e relatórios, preencha com seu clientConfig)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ENTERPRISE SECURITY CONFIGURATION
NODE_ENV=development
